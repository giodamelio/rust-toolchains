[package]
name = "{{ project-name }}"
version = "0.1.0"
edition = "2024"
{%- if publish %}
license = "{{ license }}"
{%- else %}
publish = false
{%- endif %}

[dependencies]

[lints.rust]
unsafe_code = "forbid"
rust_2018_idioms = { level = "warn", priority = -1 }

[lints.clippy]
pedantic = { level = "warn", priority = -1 }
# Doc-section lints are aimed at published library APIs, not application code.
missing_errors_doc = "allow"
missing_panics_doc = "allow"
must_use_candidate = "allow"
dbg_macro = "warn"
todo = "warn"
